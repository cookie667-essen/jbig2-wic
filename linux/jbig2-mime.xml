<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/x-jbig2">
    <comment>JBIG2 Bi-level Image</comment>
    <alias type="image/jbig2"/>
    <magic priority="80">
      <match type="string" value="\x97JB2\r\n\x1a\n" offset="0"/>
    </magic>
    <glob pattern="*.jb2"/>
    <glob pattern="*.jbig2"/>
  </mime-type>
</mime-info>
